<Project Sdk="Microsoft.NET.Sdk">
  <!-- Build a Windows desktop application using .NET 8 and WinForms. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
  </PropertyGroup>
  <!-- Visual Studio restores the Open XML package used by ExcelExporter.cs. -->
  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
  </ItemGroup>
</Project>
