<Project Sdk="Microsoft.NET.Sdk">
  <!-- xUnit tests for the pay calculation logic (Soldier, PayRates2026, BahRates2026). -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <!-- Needed because the referenced app project is a WinForms project. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <!-- The app project being tested. -->
    <ProjectReference Include="..\Soldier Financial Management System.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="SoldierFinanceSample" />
  </ItemGroup>
</Project>
